# Copy to .dev.vars for local wrangler dev. Never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
APP_SECRET=REPLACE_WITH_32_BYTE_OR_LONGER_RANDOM_SECRET
ADMIN_EMAIL=admin@mesina.farm
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD 
ALLOWED_ORIGINS=https://connect.mesina.farm,https://crm.mesina.farm,http://localhost:8787

META_APP_SECRET=
META_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=
META_GRAPH_VERSION=v23.0

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_RANDOM_VERIFY_TOKEN
WHATSAPP_APP_SECRET=

CRM_BASE_URL=https://crm.mesina.farm
CRM_API_TOKEN=
CRM_SYNC_ENABLED=false
