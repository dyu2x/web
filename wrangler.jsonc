{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mesina-farms-connect",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/webhooks/*", "/health"]
  }
}
